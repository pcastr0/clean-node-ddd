{
  "name": "clean-node-ddd",
  "version": "1.0.0",
  "description": "A Node REST API Boilerplate",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/cluster.js",
    "start:single": "node dist/index.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "cross-env NODE_ENV=test mocha --config test/.mocharc.unit.js",
    "test:integration": "cross-env NODE_ENV=test mocha --config test/.mocharc.integration.js",
    "coverage": "cross-env NODE_ENV=test c8 -x 'src/container.ts' -x 'src/app/Application.ts' -x 'src/interfaces/http/**' -x 'test/**' -r html -r lcov -r text-summary mocha --config test/.mocharc.unit.js",
    "lint": "eslint 'src/**/*.ts' 'config/**/*.ts' 'test/**/*.ts' index.ts cluster.ts",
    "sequelize": "sequelize",
    "console": "cross-env NODE_ENV=development tsx src/interfaces/console/index.ts",
    "heroku-postbuild": "npm run build && NODE_ENV=production sequelize db:migrate --url=$DATABASE_URL"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trickoooo/clean-node-ddd.git"
  },
  "keywords": [
    "node",
    "express",
    "typescript",
    "ddd",
    "clean-architecture"
  ],
  "author": "Patrick Castro",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/trickoooo/clean-node-ddd/issues"
  },
  "homepage": "https://github.com/trickoooo/clean-node-ddd#readme",
  "dependencies": {
    "awilix": "^13.0.5",
    "awilix-express": "^11.0.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "http-status": "^2.1.0",
    "log4js": "^6.9.1",
    "method-override": "^3.0.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "pm2": "^7.1.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/chance": "^1.1.8",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/method-override": "^3.0.0",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "c8": "^10.1.3",
    "chai": "^4.5.0",
    "chance": "^1.1.13",
    "eslint": "^9.39.5",
    "mocha": "^11.8.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
